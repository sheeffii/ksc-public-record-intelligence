# ---------------------------------------------------------------------------
# KSC Public Record Intelligence — environment template
# Copy to .env and adjust. No real secrets belong in this file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CASE_ID=KSC-BC-2020-06

# --- Frontend ----------------------------------------------------------------
# URL the browser uses to reach the web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL the browser uses to reach the API (public)
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL the Next.js server uses to reach the API inside Docker (server-side only)
API_INTERNAL_URL=http://api:8000
# Screen data source: `mock` (bundled demo data, default) or `api` (read API).
NEXT_PUBLIC_DATA_SOURCE=mock

# --- Backend -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=ksc
POSTGRES_PASSWORD=ksc_dev_password
POSTGRES_DB=ksc
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full SQLAlchemy URL (psycopg v3 driver). Inside Docker the host is `postgres`;
# from the host machine use localhost.
DATABASE_URL=postgresql+psycopg://ksc:ksc_dev_password@postgres:5432/ksc

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) -----------------------------------
MINIO_ROOT_USER=ksc_minio
MINIO_ROOT_PASSWORD=ksc_minio_dev_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ksc_minio
MINIO_SECRET_KEY=ksc_minio_dev_password
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=ksc-documents

# --- Future AI providers (NOT required in Phase 4; leave blank) --------------
# No AI provider is called anywhere in the codebase yet. These placeholders
# exist so later phases do not have to change the env contract.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=
EMBEDDING_MODEL=
