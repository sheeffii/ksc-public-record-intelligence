# ---------------------------------------------------------------------------
# KSC Public Record Intelligence — environment template
# Copy to .env and adjust. No real secrets belong in this file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# json (one structured object per line; container default) or text
LOG_FORMAT=json
CASE_ID=KSC-BC-2020-06

# --- Frontend ----------------------------------------------------------------
# URL the browser uses to reach the web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL the browser uses to reach the API (public)
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL the Next.js server uses to reach the API inside Docker (server-side only)
API_INTERNAL_URL=http://api:8000
# Screen data source: `mock` (bundled demo data, default) or `api` (read API).
NEXT_PUBLIC_DATA_SOURCE=mock

# --- Backend -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=ksc
POSTGRES_PASSWORD=ksc_dev_password
POSTGRES_DB=ksc
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full SQLAlchemy URL (psycopg v3 driver). Inside Docker the host is `postgres`;
# from the host machine use localhost.
DATABASE_URL=postgresql+psycopg://ksc:ksc_dev_password@postgres:5432/ksc

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) -----------------------------------
MINIO_ROOT_USER=ksc_minio
MINIO_ROOT_PASSWORD=ksc_minio_dev_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ksc_minio
MINIO_SECRET_KEY=ksc_minio_dev_password
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=ksc-documents

# --- Citation-first AI / RAG -------------------------------------------------
# Safe offline default used by tests and the controlled-corpus quality gate.
# External providers are opt-in and must return the structured Phase 11 schema.
AI_PROVIDER=deterministic
AI_MODEL=citation-first-extractive-v1
AI_TEMPERATURE=0
AI_PROMPT_DIR=packages/prompts
OPENAI_COMPATIBLE_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=
ANTHROPIC_COMPATIBLE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_KEY=
# Reserved for a later measured semantic-retrieval addition. Phase 11 uses
# deterministic lexical + structured retrieval and creates no embedding.
EMBEDDING_MODEL=
