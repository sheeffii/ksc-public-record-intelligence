# Production/staging template. Copy outside Git and replace every CHANGE_ME.
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
CASE_ID=KSC-BC-2020-06
CANONICAL_HOST=records.example.org
ACME_EMAIL=operations@example.org
CANONICAL_URL=https://records.example.org
CORS_ORIGINS=https://records.example.org
NEXT_PUBLIC_APP_URL=https://records.example.org
NEXT_PUBLIC_API_URL=https://records.example.org
NEXT_PUBLIC_DATA_SOURCE=api
API_INTERNAL_URL=http://api:8000
IMAGE_PREFIX=ghcr.io/OWNER/ksc-public-record-intelligence
IMAGE_TAG=CHANGE_ME_GIT_SHA

# Application DB user: CONNECT and DML only; TLS is mandatory.
DATABASE_URL=postgresql+psycopg://ksc_app:CHANGE_ME@db.example.org:5432/ksc?sslmode=verify-full
# Migration user: schema ownership/DDL only; used by the one-shot migration job.
MIGRATION_DATABASE_URL=postgresql+psycopg://ksc_migrator:CHANGE_ME@db.example.org:5432/ksc?sslmode=verify-full
REDIS_URL=redis://:CHANGE_ME_AT_LEAST_32_CHARACTERS@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_AT_LEAST_32_CHARACTERS

# Dedicated object-store service account: list/get/put only for this bucket.
MINIO_ENDPOINT=objects.example.org:443
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS
MINIO_SECURE=true
MINIO_BUCKET_DOCUMENTS=ksc-documents-production

RESEARCHER_API_KEYS=CHANGE_ME_AT_LEAST_32_CHARACTERS
VERIFIER_API_KEYS=CHANGE_ME_DIFFERENT_AT_LEAST_32_CHARS
ADMINISTRATOR_API_KEYS=CHANGE_ME_DIFFERENT_ADMIN_32_CHARS
PRIVILEGED_RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=10485760

# Offline is the production default. Set AI_PROVIDER=disabled to turn the AI
# route off entirely. External providers require explicit opt-in.
AI_PROVIDER=deterministic
AI_MODEL=citation-first-extractive-v1
AI_EXTERNAL_ENABLED=false
AI_ALLOWED_HOSTS=api.openai.com,api.anthropic.com
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=1600
AI_MAX_DAILY_RUNS=100
AI_MAX_CONCURRENT_RUNS=2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
